rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /groups/{code} {
      // Neue Gruppe nur mit dem Gründungs-Passwort.
      // Ersetze DEIN-PASSWORT durch dein eigenes Passwort (Anführungszeichen stehen lassen).
      allow create: if request.auth != null
        && code.size() == 8
        && request.resource.data.keys().hasOnly(['createdAt', 'pw'])
        && request.resource.data.pw == 'DEIN-PASSWORT';
      // Das Gruppen-Dokument (mit dem Passwort) kann niemand lesen oder ändern.
      allow get, list, update, delete: if false;

      // Daten einer bestehenden Gruppe: für alle, die den Code kennen.
      match /{coll}/{id} {
        allow read, write: if request.auth != null
          && coll in ['members', 'tasks', 'rewards', 'entries', 'redemptions', 'archive']
          && exists(/databases/$(database)/documents/groups/$(code));
      }
    }
  }
}
